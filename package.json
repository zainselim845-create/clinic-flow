{
  "name": "clinic-flow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "desktop:build": "cross-env ELECTRON=true vite build && electron-builder --win nsis",
    "desktop:portable": "cross-env ELECTRON=true vite build && electron-builder --win portable",
    "desktop:pack": "cross-env ELECTRON=true vite build && electron-builder --dir",
    "lint": "oxlint",
    "test": "vitest run --testTimeout=30000",
    "audit": "node scripts/browser-audit/run-audit.cjs",
    "load:autocannon": "node scripts/load-testing/autocannon-benchmark.cjs",
    "load:k6": ".\\tools\\k6\\k6-v2.3.0-windows-amd64\\k6.exe run scripts/load-testing/k6-load-test.js",
    "load:artillery": "artillery run scripts/load-testing/artillery-scenario.yml",
    "load:browser": "node scripts/load-testing/playwright-concurrent-stress.cjs",
    "audit:lighthouse": "lighthouse https://clinic-flow-lh3g.vercel.app --output=json --output-path=./LIGHTHOUSE_REAL_REPORT.json --chrome-flags=\"--headless --no-sandbox\"",
    "test:prod": "node scripts/test-real-production-simulation.cjs",
    "test:security": "node scripts/security-audit/owasp-production-security-test.cjs",
    "audit:full": "node scripts/audit/check-circular-deps.cjs && node scripts/audit/check-tenant-scoping.cjs && node scripts/audit/check-n-plus-one.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/edge": "^1.3.3",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dicom-parser": "^1.8.21",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "artillery": "^2.0.34",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "docx": "^9.10.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.clinicflow.desktop",
    "productName": "ClinicFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClinicFlow"
    }
  }
}
