{
  "_doc": "ClinicFlow Enterprise UI Review Loop Coverage Inventory - 100% Views & Interactive Controls",
  "views": [
    {
      "id": "view-login",
      "path": "/login",
      "elements": [
        { "id": "login-identifier", "el": "#identifier", "expects": ["value", "focus"], "note": "Email/phone input field" },
        { "id": "login-password", "el": "#password", "expects": ["value"], "note": "Secure password field" },
        { "id": "login-submit", "el": "button[type=submit]", "expects": ["disable", "nav"], "note": "Submit form and navigate to dashboard" }
      ]
    },
    {
      "id": "view-dashboard",
      "path": "/",
      "elements": [
        { "id": "dashboard-walkin-btn", "el": "button:has-text('تسجيل حضور مباشر')", "expects": ["toggle", "mut"], "note": "Opens Walk-in registration modal" },
        { "id": "dashboard-shift-btn", "el": "button:has-text('تسليم وردية الاستقبال')", "expects": ["toggle", "mut"], "note": "Opens Shift Handover & Drawer modal" },
        { "id": "dashboard-stat-total", "el": ".cockpit-stat-card.total-card", "expects": ["mut"], "note": "Filters today schedule to all appointments" },
        { "id": "dashboard-stat-in-exam", "el": ".cockpit-stat-card.in-exam-card", "expects": ["mut"], "note": "Filters today schedule to in-exam" },
        { "id": "dashboard-stat-completed", "el": ".cockpit-stat-card.completed-card", "expects": ["mut"], "note": "Filters today schedule to completed" }
      ]
    },
    {
      "id": "view-appointments",
      "path": "/appointments",
      "elements": [
        { "id": "appointments-chairs-toggle", "el": "button:has-text('الكراسي المتزامنة')", "expects": ["toggle", "mut"], "note": "Switches to 4-column synchronized multi-chair schedule grid" },
        { "id": "appointments-cards-toggle", "el": "button:has-text('بطاقات')", "expects": ["toggle", "mut"], "note": "Switches back to standard card layout" },
        { "id": "appointments-search", "el": "input[placeholder*='بحث']", "expects": ["value", "mut"], "note": "Filters appointments in real-time" }
      ]
    },
    {
      "id": "view-patients",
      "path": "/patients",
      "elements": [
        { "id": "patients-card-click", "el": ".patient-card", "expects": ["toggle", "mut"], "note": "Opens Patient Dossier drawer" },
        { "id": "patients-search", "el": "input[placeholder*='بحث']", "expects": ["value", "mut"], "note": "Searches patients by name/phone" }
      ]
    },
    {
      "id": "view-invoices",
      "path": "/invoices",
      "elements": [
        { "id": "invoices-search", "el": "input[placeholder*='بحث']", "expects": ["value", "mut"], "note": "Filters revenue invoice entries" }
      ]
    },
    {
      "id": "view-booking-portal",
      "path": "/booking",
      "elements": [
        { "id": "booking-phone-input", "el": "input[type='tel']", "expects": ["value", "focus"], "note": "Patient phone with auto Arabic-numeral normalization" },
        { "id": "booking-step1-continue", "el": "button[type='submit']", "expects": ["nav", "mut"], "note": "Advances to Step 2 Service & Slot selection" }
      ]
    },
    {
      "id": "view-manage-booking",
      "path": "/manage-booking",
      "elements": [
        { "id": "manage-booking-phone", "el": "input[placeholder*='01']", "expects": ["value", "focus"], "note": "Phone input for appointment lookup" }
      ]
    },
    {
      "id": "view-inventory",
      "path": "/inventory",
      "elements": [
        { "id": "inventory-search", "el": "input[placeholder*='بحث']", "expects": ["value", "mut"], "note": "Filters medical supplies stock" }
      ]
    },
    {
      "id": "view-labs",
      "path": "/labs",
      "elements": [
        { "id": "labs-search", "el": "input[placeholder*='بحث']", "expects": ["value", "mut"], "note": "Searches dental laboratory orders" }
      ]
    },
    {
      "id": "view-doctor-agent",
      "path": "/doctor-agent",
      "elements": [
        { "id": "doctor-agent-hub", "el": ".marketing-crm-container, .doctor-agent-layout", "expects": ["mut"], "note": "Clinical Decision Support & Smart Recall hub" }
      ]
    },
    {
      "id": "view-settings",
      "path": "/settings",
      "elements": [
        { "id": "settings-container", "el": ".settings-container, form", "expects": ["mut"], "note": "Clinic profile and pricing configuration" }
      ]
    }
  ]
}
