# ======================================================================================
# ClinicFlow Enterprise Environment Variables Configuration
# ======================================================================================

# 1. Supabase Cloud / Backend Configuration (Required for cloud sync & auth)
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Google Identity Services (GIS) / Real Google Sign-In
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=337379604098-6bp302kv7mmsuccf806ah1tba6grkoio.apps.googleusercontent.com

# 3. AI Assistant & Clinical Copilot (OpenRouter / Gemini)
# Get your API key from https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
# Default high-performance model (e.g. google/gemini-2.0-flash-001, nvidia/nemotron-3-super-120b-a12b:free)
VITE_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 4. Application & Domain Metadata
VITE_APP_URL=https://clinic-flow-lh3g.vercel.app

# 5. Telecom SMS Gateways (Optional - can also be configured per-clinic in Settings)
# Providers supported: Cequens, EasySendSMS, SMS Misr
VITE_SMS_PROVIDER=smsmisr
VITE_SMS_API_KEY=your-sms-api-key
VITE_SMS_SENDER_ID=ClinicFlow
