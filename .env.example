# ==============================================================================
# ClinicFlow Production Environment Variables Template
# Copy this file to .env or configure in your deployment platform (e.g. Vercel)
# ==============================================================================

# --- Supabase Cloud Database & Authentication ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- OpenRouter AI Assistant ---
VITE_OPENROUTER_API_KEY=
VITE_AI_MODEL=openai/gpt-4o-mini

# --- Google OAuth Sign-In (Optional) ---
VITE_GOOGLE_CLIENT_ID=337379604098-6bp302kv7mmsuccf806ah1tba6grkoio.apps.googleusercontent.com

# --- SMS Gateways Configuration (Optional - can also be configured per clinic in Settings) ---
# Supported providers: clinicflow-gateway, easysendsms, smsmisr, cequens, textbee, sandbox, none
VITE_SMS_PROVIDER=none

# EasySendSMS (International)
VITE_EASYSENDSMS_API_KEY=
VITE_EASYSENDSMS_API_URL=https://restapi.easysendsms.app/v1/rest/sms/send

# SMSMisr (Egypt NTRA-licensed)
VITE_SMSMISR_USERNAME=
VITE_SMSMISR_PASSWORD=
VITE_SMSMISR_ENV=1
VITE_SMSMISR_API_URL=https://smsmisr.com/api/SMS/

# Cequens (Regional CPaaS)
VITE_CEQUENS_API_KEY=
VITE_CEQUENS_API_URL=https://apis.cequens.com/sms/v1/messages

# TextBee (Personal Android Gateway)
VITE_TEXTBEE_API_KEY=
VITE_TEXTBEE_DEVICE_ID=
VITE_TEXTBEE_API_URL=https://api.textbee.dev/api/v1
