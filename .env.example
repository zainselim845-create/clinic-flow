# =========================================================================
#  ClinicFlow — إعدادات البيئة ومتغيرات التشغيل (Environment Variables)
# =========================================================================

# -------------------------------------------------------------------------
# 1. قاعدة بيانات ومصادقة سوبابيز (Supabase Database & Realtime Auth)
# احصل عليها من لوحة تحكم سوبابيز: Project Settings -> API
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------------------
# 2. مساعد الطبيب الذكي السريري (OpenRouter / Gemini AI Assistant)
# احصل على المفتاح المجاني من: https://openrouter.ai/keys
# -------------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=sk-or-v1-...

# -------------------------------------------------------------------------
# 3. بوابات الرسائل النصية القصيرة (SMS Gateways)
# الخيارات المتاحة: textbee | smsmisr | cequens | vodafone
# -------------------------------------------------------------------------
VITE_SMS_PROVIDER=textbee

# أ) بوابة TextBee المجانية (عبر هاتف أندرويد العيادة وبدون اشتراكات):
VITE_TEXTBEE_API_KEY=
VITE_TEXTBEE_DEVICE_ID=

# ب) بوابة SMS Misr (الرسمية في مصر):
VITE_SMSMISR_USERNAME=
VITE_SMSMISR_PASSWORD=
VITE_SMSMISR_SENDER=CLINICFLOW
